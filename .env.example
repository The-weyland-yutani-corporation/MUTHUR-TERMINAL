# ── MU/TH/UR 6000 Terminal — Environment Configuration ──

# ── GitHub Copilot Auth ──
# Local dev: run `copilot auth login` — no token needed
# Production: fine-grained PAT with "Copilot Requests" account permission
# Create at: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=
COPILOT_MODEL=claude-sonnet-4-5

# Required for hosted/production access (at least 32 random characters).
# Never use a NEXT_PUBLIC_ variable or commit the real value.
DEMO_ACCESS_TOKEN=

# ── Node.js paths (local dev only) ──
# Required if your default node is < 22 (Copilot CLI needs node:sqlite)
# NODE_PATH=/path/to/node22+/bin/node
# CLI_PATH=/path/to/node_modules/@github/copilot/npm-loader.js

# ── Azure Deployment ──
# These mirror the GitHub Actions workflow env vars.
# Set these as GitHub Environment variables, not browser configuration.
#
# Container Apps deployment:
# AZURE_RESOURCE_GROUP=muthur-rg
# AZURE_CONTAINER_REGISTRY=muthurterminal
# AZURE_CONTAINER_APP_NAME=muthur-terminal
